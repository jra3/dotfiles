[Desktop Entry]
Name=BambuStudio
# Shadows /usr/share/applications/BambuStudio.desktop. Never put a GDK_SCALE
# here: this file is shared across machines with different monitor scales.
# bambu-studio-launch works it out from the focused monitor at launch time.
Exec=bambu-studio-launch %U
Icon=BambuStudio
Type=Application
Categories=Utility;
MimeType=x-scheme-handler/bambustudio;model/stl;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;
