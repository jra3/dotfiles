# Shared SSH config (managed via dotfiles)
# Include this at the BOTTOM of ~/.ssh/config: Include ~/.ssh/config.shared
# (ssh_config is first-match-wins; including last lets local per-host entries
# override shared ones, and the Host * fallback below stays lowest priority.)

# Canonicalize bare short names (0 dots) into the tailnet, so `ssh paperweight` is
# rewritten to paperweight.wolverine-delta.ts.net and the config is re-matched
# against the FQDN. This lets the *.<tailnet>.ts.net rule below apply to short
# names too. Dotted names (FQDNs, github.com) are left alone; bare names that
# don't resolve in the tailnet fall back to the literal.
#
# Both suffixes are listed because the tailnet's auto-generated name has changed
# (corgi-hammerhead -> wolverine-delta); ssh tries each in order and a suffix
# that doesn't resolve simply falls through, so keeping the old one is free.
# Verify the current one with: tailscale status --json | jq -r .MagicDNSSuffix
CanonicalizeHostname yes
CanonicalDomains wolverine-delta.ts.net corgi-hammerhead.ts.net
CanonicalizeMaxDots 0
CanonicalizeFallbackLocal yes

Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/cm-%C
    ControlPersist 8h

Host *.ts.net
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# Broker the laptop's YubiKey/SSH agent to every host on our own tailnet (for
# git auth/signing). Scoped to the tailnet suffixes rather than all *.ts.net so
# the agent is only forwarded to hosts we control. Short names are covered too
# via the canonicalization above (e.g. `ssh paperweight`).
Host *.wolverine-delta.ts.net *.corgi-hammerhead.ts.net
    ForwardAgent yes

Host paperweight paperweight.wolverine-delta.ts.net paperweight.corgi-hammerhead.ts.net
    User john

# Legacy alias: this host was renamed am-jallen -> paperweight (2026-08). Bare
# `am-jallen` no longer resolves in the tailnet, so CanonicalizeFallbackLocal
# leaves the argument as the literal "am-jallen" and the *.ts.net / *.<tailnet>
# blocks above never match it. That means this stanza has to restate everything
# they would have supplied -- agent forwarding and the host-key policy -- or the
# old name would behave differently from the new one.
#
# HostName is the tailnet IP, not the MagicDNS name, and deliberately so: an
# explicit HostName suppresses canonicalization, so whatever is written here is
# used verbatim from the moment this file lands. The IP survives the rename
# untouched, which makes this stanza correct both before and after the flip; the
# new name would have been a dangling reference in the window between.
# Delete this block once no muscle memory or stray script reaches for the old name.
Host am-jallen
    HostName 100.106.2.101
    User john
    ForwardAgent yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

Host cupcake cupcake.wolverine-delta.ts.net cupcake.corgi-hammerhead.ts.net
    User jallen

Host github.com
    HostName github.com
    User git
    ServerAliveInterval 60
    ServerAliveCountMax 3
