#!/bin/sh
# Rebuild ~/.ssh/authorized_keys from the committed per-machine key files in
# ~/.ssh/authorized_keys.d/ (stowed from the dotfiles repo).
#
# Only the *public* halves of the YubiKey resident FIDO2 credentials live in the
# repo, so any host can be taught to trust every machine without the originating
# machine being online — which is the whole point: previously the key material
# existed only in each host's hand-edited authorized_keys.
#
# authorized_keys itself is NOT stowed. It stays host-local and generated, so a
# host can be given a different subset later by dropping files from the .d dir.
#
# Idempotent. Keeps a timestamped backup and refuses to install an empty file,
# so a mistake here cannot lock you out of the host you are running it on.
set -eu

dir="$HOME/.ssh/authorized_keys.d"
out="$HOME/.ssh/authorized_keys"
tmp="$out.tmp.$$"

[ -d "$dir" ] || { echo "build-authorized-keys: no $dir" >&2; exit 1; }

{
	echo "# GENERATED by build-authorized-keys — do not edit."
	echo "# Source: ~/.ssh/authorized_keys.d/*.pub (dotfiles: ssh/.ssh/authorized_keys.d/)"
	echo "# Add or remove keys there, then re-run: build-authorized-keys"
	echo
	for f in "$dir"/*.pub; do
		[ -f "$f" ] || continue
		echo "# --- $(basename "$f") ---"
		cat "$f"
		echo
	done
} > "$tmp"

# Count real key lines (ignore comments/blanks); never install an empty set.
n=$(grep -cE '^[^#[:space:]]' "$tmp" || true)
if [ "${n:-0}" -eq 0 ]; then
	rm -f "$tmp"
	echo "build-authorized-keys: refusing to install 0 keys; left $out alone" >&2
	exit 1
fi

if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
	rm -f "$tmp"
	echo "build-authorized-keys: already up to date ($n keys)"
	exit 0
fi

[ -f "$out" ] && cp -p "$out" "$out.bak.$(date +%Y%m%d-%H%M%S)"
mv "$tmp" "$out"
chmod 600 "$out"
echo "build-authorized-keys: installed $n keys into $out"
