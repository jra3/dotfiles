#!/bin/sh
# Rebuild ~/.ssh/authorized_keys from the committed per-machine key files in
# ~/.ssh/authorized_keys.d/ (stowed from the dotfiles repo).
#
# Only the *public* halves of the YubiKey resident FIDO2 credentials live in the
# repo, so any host can be taught to trust every machine without the originating
# machine being online — which is the whole point: previously the key material
# existed only in each host's hand-edited authorized_keys.
#
# authorized_keys itself is NOT stowed. It stays host-local and generated, so a
# host can be given a different subset later by dropping files from the .d dir.
#
# Idempotent. Keeps a timestamped backup and refuses to install an empty file,
# so a mistake here cannot lock you out of the host you are running it on.
#
# It also refuses to *revoke*: if the authorized_keys already on this host holds
# a key the .d directory does not, the first run here would silently drop it and
# lock out whatever was using it. Hand-edited files are full of those. So the
# default is to stop and list them.
#
#   build-authorized-keys            # stop if any currently-trusted key would be lost
#   build-authorized-keys --adopt    # park those keys in a host-local .d file first
#   build-authorized-keys --prune    # accept the loss; revoke them
set -eu

dir="$HOME/.ssh/authorized_keys.d"
out="$HOME/.ssh/authorized_keys"
tmp="$out.tmp.$$"
old_blobs="$out.blobs.old.$$"
new_blobs="$out.blobs.new.$$"
lost="$out.lost.$$"

mode=check
for arg in "$@"; do
	case "$arg" in
		--adopt) mode=adopt ;;
		--prune) mode=prune ;;
		-h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "build-authorized-keys: unknown option: $arg" >&2; exit 1 ;;
	esac
done

trap 'rm -f "$tmp" "$old_blobs" "$new_blobs" "$lost"' EXIT INT TERM

[ -d "$dir" ] || { echo "build-authorized-keys: no $dir" >&2; exit 1; }

# The base64 key body is the only stable identity for a line: comments get
# retyped, and per-key options (no-touch-required) come and go.
blobs() {
	awk '
		/^[[:space:]]*#/ { next }
		/^[[:space:]]*$/ { next }
		{
			for (i = 1; i <= NF; i++)
				if ($i ~ /^AAAA[A-Za-z0-9+\/=]+$/) { print $i; break }
		}
	' "$1" | sort -u
}

generate() {
	{
		echo "# GENERATED by build-authorized-keys — do not edit."
		echo "# Source: ~/.ssh/authorized_keys.d/*.pub (dotfiles: ssh/.ssh/authorized_keys.d/)"
		echo "# Add or remove keys there, then re-run: build-authorized-keys"
		echo
		for f in "$dir"/*.pub; do
			[ -f "$f" ] || continue
			echo "# --- $(basename "$f") ---"
			cat "$f"
			echo
		done
	} > "$tmp"
}

generate

# Count real key lines (ignore comments/blanks); never install an empty set.
n=$(grep -cE '^[^#[:space:]]' "$tmp" || true)
if [ "${n:-0}" -eq 0 ]; then
	echo "build-authorized-keys: refusing to install 0 keys; left $out alone" >&2
	exit 1
fi

# --- Revocation guard ------------------------------------------------------
if [ -f "$out" ] && [ "$mode" != prune ]; then
	blobs "$out" > "$old_blobs"
	blobs "$tmp" > "$new_blobs"
	comm -23 "$old_blobs" "$new_blobs" > "$lost"

	if [ -s "$lost" ]; then
		local_file="$dir/00-$(hostname -s 2>/dev/null || hostname)-local.pub"

		if [ "$mode" = adopt ]; then
			[ -f "$local_file" ] || cat > "$local_file" <<-EOF
				# $(hostname -s 2>/dev/null || hostname) — HOST-LOCAL keys. NOT in the dotfiles repo,
				# NOT stowed.
				#
				# Adopted by \`build-authorized-keys --adopt\` from the hand-edited
				# ~/.ssh/authorized_keys this host had before it was generated. Everything
				# here was already trusted; keeping it means regenerating the file cannot
				# revoke access that already worked.
				#
				# Promote a key to ssh/.ssh/authorized_keys.d/<machine>.pub once you know
				# which machine it belongs to — that grants it on every host, so do it
				# deliberately — and delete the rest.
			EOF
			# Copy the full original line for each lost blob, in file order.
			awk -v lost="$lost" '
				BEGIN { while ((getline b < lost) > 0) want[b] = 1 }
				/^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
				{
					for (i = 1; i <= NF; i++)
						if ($i ~ /^AAAA[A-Za-z0-9+\/=]+$/) {
							if (want[$i] && !done[$i]) { done[$i] = 1; print }
							break
						}
				}
			' "$out" >> "$local_file"
			chmod 600 "$local_file"
			echo "build-authorized-keys: adopted $(wc -l < "$lost" | tr -d ' ') key(s) into $local_file"
			generate
			n=$(grep -cE '^[^#[:space:]]' "$tmp" || true)
		else
			echo "build-authorized-keys: refusing to revoke $(wc -l < "$lost" | tr -d ' ') key(s)" >&2
			echo "that $out trusts today but $dir does not:" >&2
			echo >&2
			awk -v lost="$lost" '
				BEGIN { while ((getline b < lost) > 0) want[b] = 1 }
				/^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
				{
					for (i = 1; i <= NF; i++)
						if ($i ~ /^AAAA[A-Za-z0-9+\/=]+$/) {
							if (want[$i] && !done[$i]) { done[$i] = 1; print "    " $0 }
							break
						}
				}
			' "$out" >&2
			echo >&2
			echo "Keep them:   build-authorized-keys --adopt   (parks them in $local_file)" >&2
			echo "Revoke them: build-authorized-keys --prune" >&2
			exit 1
		fi
	fi
fi

if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
	echo "build-authorized-keys: already up to date ($n keys)"
	exit 0
fi

[ -f "$out" ] && cp -p "$out" "$out.bak.$(date +%Y%m%d-%H%M%S)"
mv "$tmp" "$out"
chmod 600 "$out"
echo "build-authorized-keys: installed $n keys into $out"
