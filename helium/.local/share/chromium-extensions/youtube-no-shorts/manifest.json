{
  "manifest_version": 3,
  "name": "YouTube: No Shorts",
  "version": "1.0",
  "description": "Removes Shorts from YouTube. Shelves, sidebar entry, channel tab, filter chips and search hits are hidden; /shorts/<id> redirects to the normal watch page.",
  "key": "",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "shorts-redirects", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["no-shorts.css"],
      "js": ["no-shorts.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
