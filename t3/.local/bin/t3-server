#!/bin/bash
# Runs the mise-managed T3 Code server (npm:t3). Execs the platform binary
# directly so systemd signals reach the server, not npm's node wrapper.
set -euo pipefail
root="$(mise where npm:t3)"
exec "$root/node_modules/.mise/node_modules/@t3code/t3-linux-x64/t3" serve \
  --base-dir "$HOME/.t3" --host 127.0.0.1 --port 3773 "$@"
