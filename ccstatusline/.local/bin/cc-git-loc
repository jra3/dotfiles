#!/usr/bin/env bash
# ccstatusline custom-command widget: the current branch, coloured by where it
# lives. Magenta in the primary checkout, yellow in a linked worktree. The
# colour is the whole point: yellow means "this is a throwaway ga/gd worktree".
# The worktree's own name is not printed — a ga worktree is named after its
# branch and its directory sits one segment to the left already, and git's
# internal name for it is mangled anyway (.dotfiles--honk -> -dotfiles--honk).
# Receives ccstatusline JSON on stdin (ignored — git already knows the cwd).
set -euo pipefail

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

YELLOW='\e[33m'
MAGENTA='\e[35m'
RST='\e[0m'

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
[[ "$BRANCH" == "HEAD" ]] && BRANCH=$(git rev-parse --short HEAD)

# A linked worktree's git-dir is <repo>/.git/worktrees/<name>; the primary
# checkout's is just <repo>/.git. Same test ccstatusline's own git-worktree
# widget makes before it prints "main" for the primary.
case "$GIT_DIR" in
  */worktrees/*) COLOR=$YELLOW ;;
  *)             COLOR=$MAGENTA ;;
esac
printf "${COLOR}%s${RST}" "$BRANCH"
