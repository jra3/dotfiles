#!/bin/bash
# Post-install system configuration
# Safe to re-run (idempotent). Requires sudo for some operations.

set -euo pipefail

echo "Configuring system..."

# --- Tailscale ---
if command -v tailscale &>/dev/null; then
    echo "Configuring Tailscale..."
    sudo systemctl enable --now tailscaled
    sudo tailscale set --operator="$USER"
    echo "  Tailscale operator set to $USER"
    echo "  Run 'tailscale up' if not yet authenticated."
else
    echo "  Tailscale not installed, skipping."
fi

# --- SSH: enable + bind to the Tailscale interface only ---
# Requires Tailscale to be up (authenticated) so its address is known. On a
# brand-new machine, run 'tailscale up' first, then re-run this script.
#
# MULTI-TAILNET: this host joins more than one tailnet (work + personal), but
# only one profile is active at a time and `tailscale ip` reports only that one.
# So each run MERGES the active profile's addresses into the drop-in and leaves
# earlier profiles' entries alone. To cover every tailnet, run once per profile:
#   tailscale switch personal && pacman/configure-system
# Binding an inactive profile's addresses needs net.*.ip_nonlocal_bind=1 (set
# below); without it sshd binds only the live set and then silently stops
# listening the moment you `tailscale switch` — the socket stays open on an
# address that no longer exists on tailscale0, so nothing ever reaches it.
SSHD_TS_CONF=/etc/ssh/sshd_config.d/10-tailscale-only.conf
if command -v tailscale &>/dev/null && command -v sshd &>/dev/null; then
    ts_v4="$(tailscale ip -4 2>/dev/null || true)"
    ts_v6="$(tailscale ip -6 2>/dev/null || true)"
    if [ -n "$ts_v4" ]; then
        ts_profile="$(tailscale debug prefs 2>/dev/null |
                        sed -n 's/.*"ProfileName": *"\([^"]*\)".*/\1/p')"
        : "${ts_profile:=unknown}"
        echo "Binding sshd to Tailscale addresses ($ts_v4${ts_v6:+, $ts_v6}) [$ts_profile]..."

        sudo rm -f /etc/ssh/sshd_config.d/10-tailscale.conf  # retired earlier name

        # Keep entries from previous runs (other tailnets); append ours if new.
        ts_lines="$(sudo sed -n '/^ListenAddress /p' "$SSHD_TS_CONF" 2>/dev/null || true)"
        for addr in $ts_v4 $ts_v6; do
            case "$ts_lines" in
                *"ListenAddress $addr"*) ;;
                *)
                    if [ -n "$ts_lines" ]; then
                        ts_lines="$ts_lines
ListenAddress $addr  # $ts_profile"
                    else
                        ts_lines="ListenAddress $addr  # $ts_profile"
                    fi
                    ;;
            esac
        done
        {
            echo "# Managed by dotfiles configure-system. Accumulates one entry per"
            echo "# tailnet: re-run after 'tailscale switch <profile>' to add another."
            echo "# Requires net.*.ip_nonlocal_bind=1 (/etc/sysctl.d/99-nonlocal-bind.conf)"
            echo "# so the inactive profile's addresses still bind."
            printf '%s\n' "$ts_lines"
        } | sudo tee "$SSHD_TS_CONF" >/dev/null

        # Bind addresses that aren't on an interface yet (the inactive tailnet's,
        # and the active one's during the boot race before tailscaled is up).
        printf '%s\n' \
            '# Let sshd bind every tailnet address, including profiles that are not' \
            '# currently active. See /etc/ssh/sshd_config.d/10-tailscale-only.conf.' \
            'net.ipv4.ip_nonlocal_bind = 1' \
            'net.ipv6.ip_nonlocal_bind = 1' \
            | sudo tee /etc/sysctl.d/99-nonlocal-bind.conf >/dev/null
        sudo sysctl -q --system

        # Order sshd after Tailscale and retry, so it can still bind once the
        # Tailscale address is configured on the interface during boot.
        sudo install -d /etc/systemd/system/sshd.service.d
        sudo rm -f /etc/systemd/system/sshd.service.d/10-after-tailscaled.conf  # retired earlier name
        printf '%s\n' \
            '[Unit]' \
            'After=tailscaled.service' \
            'Wants=tailscaled.service' \
            '' \
            '[Service]' \
            'Restart=on-failure' \
            'RestartSec=3' \
            | sudo tee /etc/systemd/system/sshd.service.d/10-tailscale.conf >/dev/null

        if sudo sshd -t; then
            sudo systemctl daemon-reload
            sudo systemctl enable sshd
            sudo systemctl restart sshd
            echo "  sshd enabled on boot and bound to Tailscale only."
        else
            echo "  ERROR: sshd config test failed; left previous runtime config in place." >&2
        fi
    else
        echo "  Tailscale not up yet (run 'tailscale up'); skipping SSH setup."
    fi
else
    echo "  sshd or Tailscale not present; skipping SSH setup."
fi

# --- Tailnet ingress filter (replaces `tailscale --shields-up`) ---
# Shields-up is all-or-nothing and overrides tailnet ACLs, so it cannot express
# "block everything except SSH". Instead shields stay DOWN and an nftables table
# does the filtering — see tsfilter.nft for why it hooks prerouting rather than
# input (short version: Docker-published ports never traverse INPUT).
# Shields are per-profile, so this clears them on the ACTIVE profile only; the
# same "run once per profile" rule as the sshd binding above applies.
if command -v nft &>/dev/null && command -v tailscale &>/dev/null; then
    echo "Installing tailnet ingress filter..."
    TSFILTER_SRC="$(cd "$(dirname "$0")" && pwd)/tsfilter.nft"
    if [ -f "$TSFILTER_SRC" ]; then
        sudo install -m 0644 "$TSFILTER_SRC" /etc/tsfilter.nft
        printf '%s\n' \
            '[Unit]' \
            'Description=Tailnet ingress filter (SSH + Ollama only)' \
            'After=tailscaled.service' \
            'Wants=tailscaled.service' \
            '' \
            '[Service]' \
            'Type=oneshot' \
            'RemainAfterExit=yes' \
            'ExecStart=/usr/bin/nft -f /etc/tsfilter.nft' \
            'ExecStop=/usr/bin/nft delete table inet tsfilter' \
            '' \
            '[Install]' \
            'WantedBy=multi-user.target' \
            | sudo tee /etc/systemd/system/tsfilter.service >/dev/null
        sudo systemctl daemon-reload
        sudo systemctl enable tsfilter.service
        sudo systemctl restart tsfilter.service
        tailscale set --shields-up=false
        echo "  tsfilter active; shields-up cleared on the active profile."
    else
        echo "  tsfilter.nft not found next to this script, skipping."
    fi
else
    echo "  nft or Tailscale not present; skipping tailnet filter."
fi

# --- SSH client control sockets ---
# config.shared enables connection multiplexing with `ControlPath ~/.ssh/sockets/cm-%C`.
# ssh won't create the directory itself, so every connection fails until it exists.
echo "Ensuring SSH control-socket dir..."
install -d -m 700 "$HOME/.ssh/sockets"
echo "  ~/.ssh/sockets present."

# --- SSH agent key list (host-local) ---
# ssh-add-keys.service loads the sk keys named in ~/.ssh/agent-keys. Which keys
# belong in the agent varies per host, so the file is host-local (~/.ssh is not
# stowed; it never enters the repo) and each host seeds its own: if the file is
# missing, list every sk private key already on disk. Re-runs never touch an
# existing file, so curate it freely after seeding.
if [ ! -f "$HOME/.ssh/agent-keys" ]; then
    echo "Seeding ~/.ssh/agent-keys from on-disk sk keys..."
    {
        echo "# SK keys to load into the ssh-agent on THIS host (read by ssh-add-keys.service)."
        echo "# One key per line, relative to ~/.ssh (absolute paths also work). '#' comments"
        echo "# and blank lines are ignored; entries whose file is missing are skipped."
        echo "# Host-local: ~/.ssh is not stowed, so this file never enters the dotfiles repo."
        for key in "$HOME"/.ssh/id_*sk*; do
            if [[ $key != *.pub && -f $key ]]; then
                echo "${key##*/}"
            fi
        done
    } > "$HOME/.ssh/agent-keys"
    chmod 600 "$HOME/.ssh/agent-keys"
    echo "  seeded: $(grep -vc '^#' "$HOME/.ssh/agent-keys") key(s). Edit ~/.ssh/agent-keys to curate."
else
    echo "  ~/.ssh/agent-keys already present; leaving it alone."
fi

# --- SSH agent (user) ---
# Run OpenSSH's own ssh-agent (FIDO2/sk-capable, unlike gnome-keyring's) and
# auto-load this machine's YubiKey keys into it at login, so SSH agent
# forwarding (e.g. to am-jallen / chonky) can broker them. SSH_AUTH_SOCK is
# pointed at the socket via ssh/.config/environment.d/ssh-agent.conf.
# ssh-add-keys.service is stowed from the `ssh` package and self-skips (via
# ConditionPathExists) until ~/.ssh/agent-keys exists — seeded just above, so
# ordering here matters.
if command -v ssh-agent &>/dev/null; then
    echo "Configuring SSH agent (user)..."
    systemctl --user enable --now ssh-agent.socket
    if systemctl --user cat ssh-add-keys.service &>/dev/null; then
        systemctl --user enable --now ssh-add-keys.service
        echo "  ssh-agent socket + key auto-load enabled."
    else
        echo "  ssh-agent socket enabled; ssh-add-keys.service not stowed, skipping."
    fi
else
    echo "  ssh-agent not installed, skipping."
fi

# --- Emacs ---
if command -v emacs &>/dev/null; then
    echo "Configuring Emacs daemon..."
    systemctl --user enable --now emacs
    echo "  Emacs daemon enabled."
else
    echo "  Emacs not installed, skipping."
fi

# --- Power: hibernation + low-battery policy ---
# Hibernation is provisioned by the Omarchy installer (swapfile + resume= on
# the cmdline). Note: any app holding memfd_secret() memory disables hibernate
# kernel-wide (the Bitwarden desktop app did this until we replaced it with
# rbw). We deliberately keep secretmem ENABLED as a tripwire — the kernel
# refusing to hibernate beats writing an opted-in app's secrets to disk. If
# hibernate ever reports unavailable again, find the holder:
#   sudo grep -l secretmem /proc/[0-9]*/maps
# rbw's own keys are purged pre-sleep by hypridle's before_sleep_cmd instead.
echo "Configuring power management..."
if [ -f /etc/limine-entry-tool.d/secretmem.conf ]; then
    sudo rm /etc/limine-entry-tool.d/secretmem.conf
    sudo limine-update
    echo "  Removed stale secretmem.enable=0 from kernel cmdline."
fi

# Hibernate at 5% instead of UPower's default hard poweroff at 2%.
sudo sed -i \
    -e 's/^PercentageCritical=.*/PercentageCritical=10.0/' \
    -e 's/^PercentageAction=.*/PercentageAction=5.0/' \
    -e 's/^CriticalPowerAction=.*/CriticalPowerAction=Hibernate/' \
    /etc/UPower/UPower.conf
sudo systemctl try-restart upower
echo "  UPower: hibernate at 5% (was: poweroff at 2%)."

# Lid close: suspend, then hibernate after 2h (s2idle drains a few %/hour, so
# a closed laptop should end up on disk, not dead). Applies after reboot.
sudo install -d /etc/systemd/logind.conf.d /etc/systemd/sleep.conf.d
printf '[Login]\nHandleLidSwitch=suspend-then-hibernate\n' |
    sudo tee /etc/systemd/logind.conf.d/20-suspend-then-hibernate.conf >/dev/null
printf '[Sleep]\nHibernateDelaySec=2h\n' |
    sudo tee /etc/systemd/sleep.conf.d/20-hibernate-delay.conf >/dev/null
echo "  Lid close set to suspend-then-hibernate."

# Escalating low-battery notifications (stow the `power` package first).
if systemctl --user cat battery-sentinel.timer &>/dev/null; then
    systemctl --user enable --now battery-sentinel.timer
    echo "  battery-sentinel.timer enabled."
else
    echo "  battery-sentinel.timer not stowed; run 'stow power' and re-run."
fi

# --- iPhone USB tethering (systemd-networkd) ---
# The iPhone's `ipheth` driver creates an Ethernet-class interface when Personal
# Hotspot is on and the phone is plugged in. DHCP it, with a route metric between
# real Ethernet (100) and Wi-Fi (600) so a tethered phone becomes the default
# route (e.g. on the bus) but still yields to a wired connection. IPv4 only:
# iPhone tether IPv6 is flaky and can stall connections. Extra drivers are listed
# so the same file also covers Android (RNDIS/NCM) if ever needed.
# Requires the `usbmuxd` package (in packages-arch.txt); its udev rule autostarts
# the daemon on plug-in, and pairing ("Trust This Computer") happens on first use.
# NOTE the 15- prefix: systemd-networkd applies only the FIRST matching .network
# file in lexical order. The iPhone tether often appears as `eth0`, which the
# stock 20-ethernet.network (Name=eth*) also matches — so this file must sort
# before it to win, otherwise it's silently shadowed.
echo "Configuring iPhone USB tethering..."
if systemctl is-active --quiet systemd-networkd || systemctl is-enabled --quiet systemd-networkd; then
    sudo rm -f /etc/systemd/network/25-usb-tether.network  # retired earlier name
    printf '%s\n' \
        '[Match]' \
        'Driver=ipheth rndis_host cdc_ncm cdc_ether' \
        '' \
        '[Network]' \
        'DHCP=ipv4' \
        '' \
        '[DHCPv4]' \
        'RouteMetric=200' \
        | sudo tee /etc/systemd/network/15-usb-tether.network >/dev/null
    sudo systemctl reload-or-restart systemd-networkd
    echo "  Installed /etc/systemd/network/15-usb-tether.network"
else
    # NetworkManager (or another manager) auto-connects a USB tether as a new
    # Ethernet device — no .network file needed. Skip so we don't drop a dead file.
    echo "  systemd-networkd not in use; skipping (NetworkManager tethers natively)."
fi

# --- Pacman hooks ---
echo "Installing pacman hooks..."
HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)/hooks"
if [ -d "$HOOKS_DIR" ]; then
    sudo cp "$HOOKS_DIR"/*.hook /etc/pacman.d/hooks/
    echo "  Pacman hooks installed."
else
    echo "  No hooks directory found, skipping."
fi

echo "Done!"
