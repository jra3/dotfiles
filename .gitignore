*.bak*

# System-installed shader symlinks (written by Aether into the stowed hypr dir)
hypr/.config/hypr/shaders/

# herdr runtime state, written into the stowed config dir at run time
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# Claude Code hooks are herdr's to manage. It rewrites them in place on
# integration updates (which silently drops a stowed file out of stow), and it
# owns the matching wiring in claude/.claude/settings.json.
claude/.claude/hooks/herdr-*.sh

# Python bytecode (py_compile on the stowed scripts)
__pycache__/

# Emacs lock files
.#*

# Chromium's compiled declarativeNetRequest ruleset, written into the unpacked
# extension dir at load time. It lands here rather than in ~/.local/share/
# because the helium package must be stowed FOLDED -- see helium/README.md.
helium/.local/share/chromium-extensions/*/_metadata/
