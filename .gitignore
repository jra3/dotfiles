*.bak*

# System-installed shader symlinks (written by Aether into the stowed hypr dir)
hypr/.config/hypr/shaders/

# herdr runtime state, written into the stowed config dir at run time
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# Python bytecode (py_compile on the stowed scripts)
__pycache__/

# Emacs lock files
.#*
